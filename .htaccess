RewriteEngine On

# Force HTTPS
RewriteCond %{SERVER_PORT} 80
RewriteCond %{HTTP_HOST} ^(www\.)?bestowits\.com
RewriteRule ^(.*)$ https://bestowits.com/$1 [R=301,L]

# Compress text-based responses for faster mobile/tablet downloads.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml text/xml image/svg+xml
</IfModule>

# Cache static assets so repeat visits are much faster on phones and tablets.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType text/javascript "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Long-lived caching is safe for versioned/static site assets.
  <FilesMatch "\.(css|js|svg|png|jpg|jpeg|gif|webp|ico|woff|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # Keep HTML reasonably fresh so website updates appear without long cache delays.
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>

  # Help browsers establish the font connection earlier.
  Header add Link "<https://fonts.googleapis.com>; rel=preconnect"
  Header add Link "<https://fonts.gstatic.com>; rel=preconnect; crossorigin"
</IfModule>

# Avoid unnecessary entity-tag validation for static files when caching is enabled.
<IfModule mod_headers.c>
  Header unset ETag
</IfModule>
<IfModule mod_expires.c>
  ExpiresDefault "access plus 5 minutes"
</IfModule>
FileETag None
